# Copia este archivo como .env.local y ajusta los valores. Nunca subas .env* al repositorio.

# URL base de la API de EnZona (sin barra final). En desarrollo, la API corre en el puerto 8080.
VITE_API_URL=http://localhost:8080

# true: la app usa una API simulada en el navegador (Mock Service Worker) con datos de demostración.
# Solo funciona con `npm run dev` o `npm run dev:demo`; la compilación de producción la ignora.
VITE_API_MOCK=false
