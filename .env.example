# URL base de EnZona_Api (Spring Boot). El navegador nunca la llama directamente:
# el servidor de Next.js hace de intermediario (src/app/api/enzona), así no hace
# falta tocar CORS_ORIGINS en la API y el token vive en una cookie httpOnly.
#   - API en esta PC contra la base de Aiven (iniciar_api.ps1): http://localhost:8080
#   - API en Render:                                             https://enzona-api.onrender.com
ENZONA_API_URL=http://localhost:8080

# Nombre de la cookie de sesión (opcional)
ENZONA_COOKIE=enzona_sesion
